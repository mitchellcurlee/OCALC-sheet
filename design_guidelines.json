{
  "design_system": {
    "name": "Grid-Ops Field Light",
    "description": "A high-contrast, bright white theme optimized for outdoor glare and sunlight readability, replacing the old dark mode. Follows Archetype 4 (Swiss/High-Contrast) with rigid, function-first aesthetics.",
    "theme_strategy": "light_only",
    "typography": {
      "font_family": {
        "heading": "Chivo, sans-serif",
        "body": "Inter, sans-serif",
        "mono": "JetBrains Mono, monospace"
      },
      "scale": {
        "h1": "text-4xl font-black tracking-tight uppercase text-zinc-950",
        "h2": "text-2xl font-bold tracking-tight uppercase text-zinc-900",
        "h3": "text-xl font-bold tracking-wide text-zinc-700",
        "body": "text-base font-normal leading-relaxed text-zinc-800",
        "label": "text-xs font-bold tracking-widest uppercase text-zinc-600",
        "data": "font-mono text-sm tracking-tight text-zinc-950"
      }
    },
    "colors": {
      "palette": {
        "page_background": "#ffffff",
        "card_surface": "#ffffff",
        "card_border": "#d4d4d8",
        "card_shadow": "shadow-sm",
        "input_background": "#ffffff",
        "input_border": "#a1a1aa",
        "input_placeholder": "#71717a",
        "input_focus_ring": "#dc2626",
        "text_primary": "#09090b",
        "text_secondary": "#3f3f46",
        "text_muted": "#52525b",
        "primary_button_bg": "#dc2626",
        "primary_button_text": "#ffffff",
        "section_accent_bars": "bg-zinc-200 border-zinc-300",
        "brand_red_accent": "#dc2626",
        "brand_orange_accent": "#ea580c"
      },
      "usage": {
        "power_pole_badge": "text-red-700 border-red-200 bg-red-50 font-bold",
        "telecom_pole_badge": "text-orange-700 border-orange-200 bg-orange-50 font-bold",
        "header_sticky_bar": "bg-white/95 backdrop-blur-md border-b border-zinc-200 shadow-sm",
        "mobile_bottom_nav": "bg-white/95 backdrop-blur-md border-t border-zinc-200 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)]"
      }
    },
    "layout": {
      "container": "max-w-7xl mx-auto px-4 sm:px-6 lg:px-8",
      "grid_strategy": "bento_grid_dense",
      "border_radius": "rounded-none"
    },
    "components": {
      "cards": "bg-white border border-zinc-200 shadow-sm relative overflow-hidden",
      "inputs": "bg-white border-2 border-zinc-300 text-zinc-900 placeholder:text-zinc-500 focus:ring-2 focus:ring-red-600 focus:border-transparent font-mono h-12",
      "buttons": "font-mono uppercase tracking-wider border-2 border-transparent bg-red-600 text-white hover:bg-red-700 active:scale-95 transition-all h-12"
    }
  },
  "implementation_guide": {
    "shadcn_css_variables": {
      "root": {
        "--background": "0 0% 100%",
        "--foreground": "240 10% 3.9%",
        "--card": "0 0% 100%",
        "--card-foreground": "240 10% 3.9%",
        "--popover": "0 0% 100%",
        "--popover-foreground": "240 10% 3.9%",
        "--primary": "0 72% 51%",
        "--primary-foreground": "0 0% 98%",
        "--secondary": "240 4.8% 95.9%",
        "--secondary-foreground": "240 5.9% 10%",
        "--muted": "240 4.8% 95.9%",
        "--muted-foreground": "240 3.8% 46.1%",
        "--accent": "240 4.8% 95.9%",
        "--accent-foreground": "240 5.9% 10%",
        "--destructive": "0 84.2% 60.2%",
        "--destructive-foreground": "0 0% 98%",
        "--border": "240 5.9% 80%",
        "--input": "240 5.9% 80%",
        "--ring": "0 72% 51%",
        "--radius": "0"
      }
    },
    "global_css_updates": [
      "html, body { background-color: #ffffff; color: #09090b; }",
      "::-webkit-scrollbar-track { background: #f4f4f5; }",
      "::-webkit-scrollbar-thumb { background: #a1a1aa; border-radius: 0; }",
      "::-webkit-scrollbar-thumb:hover { background: #71717a; }",
      ".industrial-card { @apply bg-white border border-zinc-300 shadow-sm relative overflow-hidden; }",
      ".industrial-input { @apply bg-white border-2 border-zinc-300 text-zinc-900 focus:ring-2 focus:ring-red-600 focus:border-transparent font-mono h-12; }",
      ".industrial-button { @apply font-mono uppercase tracking-wider border-2 border-transparent bg-red-600 text-white hover:bg-red-700 transition-all active:scale-95 h-12; }",
      ".mobile-bottom-nav { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); border-top: 1px solid #e4e4e7; z-index: 50; }",
      ".pole-power { color: #b91c1c; border-color: rgba(220, 38, 38, 0.3); background-color: rgba(254, 226, 226, 0.8); }",
      ".pole-telecom { color: #c2410c; border-color: rgba(234, 88, 12, 0.3); background-color: rgba(255, 237, 213, 0.8); }"
    ],
    "tailwind_class_mapping": {
      "bg-black": "bg-white",
      "bg-[#09090b]": "bg-white",
      "bg-zinc-900": "bg-zinc-50",
      "bg-zinc-900/50": "bg-white",
      "bg-zinc-800": "bg-zinc-100",
      "border-zinc-800": "border-zinc-200",
      "border-zinc-700": "border-zinc-300",
      "text-white": "text-zinc-900",
      "text-[#fafafa]": "text-zinc-900",
      "text-zinc-400": "text-zinc-600",
      "text-zinc-500": "text-zinc-500",
      "text-red-500": "text-red-600",
      "text-orange-500": "text-orange-600",
      "ring-red-500": "ring-red-600",
      "hover:border-white/20": "hover:border-black/20",
      "hover:bg-zinc-800": "hover:bg-zinc-100"
    }
  },
  "universal_guidelines": [
    "Prioritize high-contrast text and robust outlines over soft shadows.",
    "Input borders should be strong (zinc-300) to ensure visibility in outdoor sunlight.",
    "Primary call to action colors (red-600) must meet WCAG AA against the white background.",
    "All interactive elements MUST include a data-testid attribute.",
    "Ensure touch targets remain minimum 48px height."
  ]
}